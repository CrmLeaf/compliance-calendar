{
    "name": "crmleaf/compliance-calendar",
    "description": "Month-by-month due dates for PF, ESI, TDS, GST, PT and Form 16.",
    "keywords": ["compliance", "calendar", "due-dates", "pf", "esi", "tds", "gst", "india"],
    "homepage": "https://www.indpayroll.com/free-tools/compliance-calendar",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "CRMLeaf",
            "email": "opensource@crmleaf.app",
            "homepage": "https://www.crmleaf.app"
        }
    ],
    "support": {
        "issues": "https://github.com/crmleaf/compliance-calendar/issues",
        "source": "https://github.com/crmleaf/compliance-calendar"
    },
    "require": {
        "php": "^8.2",
        "crmleaf/payroll-core": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.58",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "crmleaf/laravel-payroll": "Installs the whole CRMLeaf payroll suite behind one config file, one Blade namespace and one optional JSON API.",
        "illuminate/support": "Only needed for the Laravel service provider, routes and Blade component. The calculator itself is framework-agnostic."
    },
    "autoload": {
        "psr-4": {
            "Crmleaf\\Payroll\\Tools\\ComplianceCalendar\\": "src/",
            "Crmleaf\\Payroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crmleaf\\Payroll\\Tools\\ComplianceCalendar\\Tests\\": "tests/",
            "Crmleaf\\Payroll\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Crmleaf\\Payroll\\Tools\\ComplianceCalendar\\ComplianceCalendarServiceProvider"
            ]
        },
        "crmleaf": {
            "tool": "compliance-calendar",
            "category": "compliance",
            "backend": "optional",
            "calculator": "Crmleaf\\Payroll\\Calculators\\ComplianceCalendar",
            "generated-from": "stubs/tool/composer.json.stub via bin/generate-tools.php"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
